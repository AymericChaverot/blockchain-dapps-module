# =============================================================================
# SitePass - single configuration file for the whole monorepo.
# Copy to `.env` (or run `pnpm env:init`) and fill in the values you need.
# `pnpm env:keys` generates fresh Base Sepolia demo wallets for you.
# `.env` is git-ignored: never commit private keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Web app
# -----------------------------------------------------------------------------
# Network the web app talks to: localhost | baseSepolia
# (`pnpm web:local` and `pnpm web:base-sepolia` override this value.)
VITE_NETWORK=localhost

# demo | production
#   demo: every page reachable, demo console, seeded samples and (local chain)
#         a built-in persona wallet; can preview the production experience.
#   production: navigation and page access follow the connected wallet's
#         on-chain role (visitor, worker, issuer, registry admin).
VITE_APP_MODE=demo

# Public RPC endpoints used by the browser (they are embedded in the bundle:
# do not put a secret API key here unless it is domain-restricted).
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: override the contract addresses written by the deploy script
# into apps/web/src/config/deployments.json.
VITE_ISSUER_REGISTRY_ADDRESS=
VITE_SITE_CREDENTIAL_MANAGER_ADDRESS=

# -----------------------------------------------------------------------------
# Local development (pnpm dev / pnpm chain)
# Nothing to configure: Hardhat's well-known test accounts are used.
#   #0 deployer + registry admin, #1 issuer A, #2 issuer B, #3 holder, #4 attacker
# -----------------------------------------------------------------------------
LOCAL_RPC_URL=http://127.0.0.1:8545

# -----------------------------------------------------------------------------
# Base Sepolia deployment (pnpm deploy:base-sepolia)
# -----------------------------------------------------------------------------
# RPC used by the deploy/seed scripts (Alchemy/Infura/QuickNode URL recommended).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer: needs Base Sepolia ETH (faucet). It deploys the contracts, acts as
# temporary registry admin to register the demo issuers, and tops up the
# issuers with a little gas for seeding.
DEPLOYER_PRIVATE_KEY=

# Demo issuers (training organizations). Their keys sign the seed credentials;
# import them in MetaMask to use the issuer UI during the demo.
ISSUER_A_PRIVATE_KEY=
ISSUER_A_NAME="Apave Formation (demo)"
ISSUER_A_DOMAIN=apave.com
ISSUER_B_PRIVATE_KEY=
ISSUER_B_NAME="Dekra Industrial (demo)"
ISSUER_B_DOMAIN=dekra.com

# Demo worker wallet. Only the address is used by the scripts; the key is kept
# here just so you can import it in MetaMask (generated by `pnpm env:keys`).
HOLDER_ADDRESS=
HOLDER_PRIVATE_KEY=

# Optional: non-issuer account used by `pnpm demo:failures:*` (defaults to the holder).
ATTACKER_ADDRESS=

# Optional but recommended: Safe multisig that becomes the registry admin after
# seeding (two-step transfer, the Safe must call acceptOwnership()).
REGISTRY_ADMIN_ADDRESS=

# Optional: Etherscan API v2 key to verify the sources on Basescan
# (Blockscout and Sourcify are tried anyway, without a key).
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Seeding
# -----------------------------------------------------------------------------
# Set to false to deploy without demo credentials.
SEED_DEMO_DATA=true
# Lifetime of the "short expiry" demo credential, in minutes.
SEED_SHORT_EXPIRY_MINUTES=5
